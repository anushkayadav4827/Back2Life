{
  "app": "npx ts-node --prefer-ts-exts cdk/bin/back2life.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "yarn.lock",
      "node_modules",
      "test"
    ]
  },
  "context": {
    "aws-cdk:enableDiffNoFail": "true"
  }
}
